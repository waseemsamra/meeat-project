
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      /**
       * WARNING: These rules are for TEMPORARY TESTING ONLY.
       * They allow anyone on the internet to read and write all data in your database.
       * RESTORE SECURE RULES before launching your application.
       */
      allow read, write: if true;
    }
  }
}
