
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Defines if the user is signed in
     */
    function isSignedIn() {
      return request.auth != null;
    }
    
    /**
     * @description Checks if the UID in the request matches the provided userId.
     */
    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if a user has a given role by reading their user document.
     */
    function hasRole(role) {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny([role]);
    }

    /**
     * @description Defines if the user is the owner of the resource OR an admin.
     */
    function isOwner(userId) {
      return isUser(userId) || hasRole('ADMIN');
    }

    /**
     * @description Rules for the 'orders' collection group.
     * Essential for Android apps to fetch user history via collectionGroup queries.
     */
    match /{path=**}/orders/{orderId} {
      allow read: if (isSignedIn() && (request.auth.uid == resource.data.userId)) || hasRole('ADMIN') || hasRole('STAFF');
      allow write, update, delete: if hasRole('ADMIN');
    }

    /**
     * @description Rules for the 'orders_items' collection group.
     * Supports fetching individual line items securely.
     */
    match /{path=**}/orders_items/{orderItemId} {
      allow read: if (isSignedIn() && (request.auth.uid == resource.data.userId)) || hasRole('ADMIN');
      allow create: if isSignedIn() || request.auth == null;
      allow delete: if hasRole('ADMIN');
    }

    /**
     * @description Rules for the /users/{userId} collection.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if hasRole('ADMIN');
      allow create: if isUser(userId) || (hasRole('ADMIN') && request.resource.data.customerType == 'LOCAL');
      allow update: if isOwner(userId);
      allow delete: if hasRole('ADMIN');

      /**
       * @description Rules for the /users/{userId}/orders/{orderId} subcollection.
       */
      match /orders/{orderId} {
        allow read: if isOwner(userId);
        allow create: if isUser(userId) || hasRole('STAFF') || hasRole('ADMIN') || request.auth == null;
        allow update: if isOwner(userId);
        allow delete: if hasRole('ADMIN');
      }

      /**
       * @description Rules for the /users/{userId}/addresses/{addressId} subcollection.
       */
      match /addresses/{addressId} {
        allow get, list: if isOwner(userId);
        allow create: if isUser(userId) && request.resource.data.userId == userId;
        allow update: if (isOwner(userId) && request.resource.data.userId == resource.data.userId);
        allow delete: if isOwner(userId);
      }
    }
    
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow write: if hasRole('ADMIN');
    }

    /**
     * @description Public Catalog Collections.
     * Accessible to both Web and Android storefronts without authentication.
     */
    match /products/{productId} { allow get, list: if true; allow write: if hasRole('ADMIN') || hasRole('CONTENT_MANAGER'); }
    match /categories/{categoryId} { allow get, list: if true; allow write: if hasRole('ADMIN') || hasRole('CONTENT_MANAGER'); }
    match /cutTypes/{cutTypeId} { allow get, list: if true; allow write: if hasRole('ADMIN') || hasRole('CONTENT_MANAGER'); }
    match /grades/{gradeId} { allow get, list: if true; allow write: if hasRole('ADMIN') || hasRole('CONTENT_MANAGER'); }
    match /countries/{countryId} { allow get, list: if true; allow write: if hasRole('ADMIN') || hasRole('CONTENT_MANAGER'); }
    match /currencies/{currencyId} { allow get, list: if true; allow write: if hasRole('ADMIN'); }
    match /languages/{languageId} { allow get, list: if true; allow write: if hasRole('ADMIN'); }
    match /measurementUnits/{measurementUnitId} { allow get, list: if true; allow write: if hasRole('ADMIN'); }
    match /styles/{styleId} { allow get, list: if true; allow write: if hasRole('ADMIN'); }
    match /rubs/{rubId} { allow get, list: if true; allow write: if hasRole('ADMIN'); }
    match /temperatures/{temperatureId} { allow get, list: if true; allow write: if hasRole('ADMIN'); }
    match /categoryBanners/{bannerId} { allow get, list: if true; allow write: if hasRole('ADMIN'); }
    match /boxOptions/{boxId} { allow get, list: if true; allow write: if hasRole('ADMIN'); }
    match /exploreRangeItems/{itemId} { allow get, list: if true; allow write: if hasRole('ADMIN'); }
    match /chooseBoxSteps/{stepId} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /realCutPics/{picId} { allow read: if true; allow write: if hasRole('ADMIN'); }
    match /settings/{settingId} { allow read: if true; allow write: if hasRole('ADMIN'); }

    /**
     * @description Administrative/Staff Collections.
     */
    match /inventoryLots/{lotId} { allow read, list: if true; allow write: if hasRole('ADMIN'); }
    match /vendors/{vendorId} { allow get, list: if hasRole('ADMIN') || hasRole('STAFF'); allow write: if hasRole('ADMIN'); }
    match /deliveries/{deliveryId} { allow read, list, write: if hasRole('ADMIN') || hasRole('STAFF'); }
    match /invoices/{invoiceId} { allow read, list, write: if hasRole('ADMIN') || hasRole('ACCOUNTANT'); }
    match /payments/{paymentId} { allow read, list, write: if hasRole('ADMIN') || hasRole('ACCOUNTANT'); }
    match /creditNotes/{creditNoteId} { allow read, list, write: if hasRole('ADMIN') || hasRole('ACCOUNTANT'); }
    match /debitNotes/{debitNoteId} { allow read, list, write: if hasRole('ADMIN') || hasRole('ACCOUNTANT'); }
    match /socialPosts/{postId} { allow read, list: if true; allow write: if hasRole('ADMIN'); }
  }
}
